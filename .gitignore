# graft's local code-graph cache, like node_modules — regenerable, never committed.
/graft/

# Headless screenshot output from tools/probe.js
.probe/

# Scratch / personal — never commit
_to_delete/
docs/feedback.md

# Loose raster dropped in the ROOT of art/ — the owner's own reference material,
# which is private and must never reach a public repo. Every sanctioned image in
# this game lives in a FOLDER (art/announcements/, art/reveals/, docs/screens/ —
# see the binary-asset exceptions in docs/09-conventions.md), so the root itself
# is always scratch. This is here because one `git add -A` was the only thing
# standing between a private file and a public deploy.
art/*.png
art/*.jpg
art/*.jpeg
art/*.webp

# Sprites rasterised by tools/export-pngs.js for the Unity port. Build output,
# not an asset this game ships — docs/09-conventions.md allows no binaries beyond
# its three named folders, and adding a fourth for 168 generated PNGs would buy
# nothing. Regenerate them on demand, or send them straight to the consumer with
# --out. art/exports/** stays text, and stays a mirror.
art/exports/png/
